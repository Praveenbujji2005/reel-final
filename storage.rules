rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to validate media file uploads (images & videos up to 100MB)
    function isValidMedia() {
      return request.resource.size < 100 * 1024 * 1024 &&
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType.matches('video/.*') ||
              request.resource.contentType == 'application/octet-stream');
    }

    // =========================================================================
    // Public Website Assets & Uploaded CMS Media:
    // - Public visitors can READ/STREAM images and videos
    // - Uploads are allowed for media files under 100MB
    // =========================================================================
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isValidMedia();
      allow delete: if true;
    }

    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if isValidMedia();
      allow delete: if true;
    }

    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isValidMedia();
      allow delete: if true;
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      allow write: if isValidMedia();
      allow delete: if true;
    }

    // General fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isValidMedia();
    }
  }
}
