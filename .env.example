# ==============================================================================
# REELXPRESS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate the secrets securely.
# ==============================================================================

# Core Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Firebase Client Configuration (Cloud Firestore & Firebase Storage)
# Obtain these from: https://console.firebase.google.com/
# Project Settings > General > Your Apps > Web App Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"

# Cloudinary Media Delivery (Optional Fallback)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# WhatsApp Direct Dispatch Integration
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

# Contact Notifications Email
NOTIFICATION_EMAIL_TO="hello@reelxpress.com"

# ==============================================================================
# CMS Security & Server Authentication (SERVER-ONLY, NEVER PREFIX WITH NEXT_PUBLIC_)
# ==============================================================================
ADMIN_SECRET_KEY="generate_a_random_32_character_secret_string_here"
ADMIN_DEFAULT_EMAIL="admin@reelxpress.com"
# Bcrypt hash generated via bcrypt.hash(password, 12). Recommended for production.
ADMIN_PASSWORD_HASH="$2b$12$YourBcryptPasswordHashHere"
# Optional fallback plain-text password for initial setup only
# ADMIN_DEFAULT_PASSWORD="YourStrongAdminPasswordHere"

# ==============================================================================
# Google Calendar Integration (OAuth 2.0 Web Client)
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:3000/api/google-calendar/callback
# ==============================================================================
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/google-calendar/callback"

# ==============================================================================
# Google Sheets Lead Sync (SERVER-ONLY) - see google-apps-script/leads-sheet/README.md
# Web app URL from Apps Script: Deploy > New deployment > Web app
# Secret must match the WEBHOOK_SECRET script property in Apps Script
# ==============================================================================
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your_deployment_id/exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="generate_a_long_random_secret_here"
