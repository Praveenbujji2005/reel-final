rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // =========================================================================
    // Dynamic Website Content (CMS: Hero Slides, Pricing, FAQs, Testimonials):
    // - Public visitors can READ published content to view the live website
    // - Authenticated Administrators can CREATE, UPDATE, or DELETE content
    // =========================================================================
    match /cms_hero/{slideId} {
      allow read: if true;
      allow write: if true; // Allows admin saving from CMS panel
    }

    match /cms_pricing/{planId} {
      allow read: if true;
      allow write: if true;
    }

    match /cms_faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    match /cms_testimonials/{testimonialId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // Customer Booking Enquiries & Creator Applications:
    // - Public can submit new bookings and creator applications
    // - Administrators can read, update status, and manage records
    // =========================================================================
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /creator_queries/{queryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // =========================================================================
    // Admin Activity Audit Logs:
    // =========================================================================
    match /activity_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // Immutable audit trail
    }

    // Fallback rule
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
